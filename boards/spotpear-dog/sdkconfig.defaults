# Cao robotico SpotBear/ZZPET (ESP32-S3R8): 16MB DIO + PSRAM 8MB OCTAL embutida.
# Derivado do smartdisplay; diferencas: flash Boya DIO (nao QIO), console no
# USB-Serial/JTAG nativo (o unico conector USB da placa), sem SD.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Stack de task na PSRAM (worker do AI no JS): sem isso o xTaskCreateWithCaps
# nao poe stack la e o boot apertado do watch nao acha bloco de 24 KB interno
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Console pelo USB-Serial/JTAG nativo (303a:1001): logs + OpenOCD. O
# SerialLink (celerctl) fala na MESMA porta USJ, multiplexado com o console
# como na UART: push/pull/dev/logcat/OTA pela unica USB da placa, sem abrir
# mao do console e do esptool ROM. Os pinos 19/20 pertencem a USJ —
# CELEROS_USB_NATIVE (OTG/CDC dupla) nao combina com esta board.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_CELEROS_LINK_ON_USJ=y

# Sem slot de cartao.
# CONFIG_CELEROS_SD_CARD is not set

# Desempenho: 16MB de flash sobram — interpretador JS e desenho com -O2.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set

# Celer Link (BLE entre CelerOS): mesmo bloco NimBLE do smartdisplay.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
# CONFIG_BT_NIMBLE_NVS_PERSIST is not set

# Watchdog de bateria por ULP-RISC-V (deep sleep do System.deepSleep): o
# coprocessador le o divisor do ADC1 (GPIO2) a cada ~60 s e acorda os
# nucleos se a celula cair de ~3,3 V — o timer do JS segue valendo. O
# binario vive na RTC slow mem (4 KB de reserva la, nada sai da DRAM).
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_RISCV=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096

# Ring de logs maior (tem PSRAM): historico do boot inteiro no logcat --dump
CONFIG_CELEROS_LOG_RING=8192

# Wake word "Hi Celer" on-device (microWakeWord V2 treinado por nos,
# TFLite Micro): o app Dog Face ouve a palavra de ativacao e abre a janela
# de comando de voz (API 20).
CONFIG_CELEROS_WAKE_WORD=y

# Pools/buffers do HOST NimBLE na PSRAM (mesmo motivo do smartdisplay): com
# o host interno o Celer Link consumia 66 KB de RAM interna (71 -> 5 KB) e
# o DMA do I2S do microfone nao alocava mais — wake word surdo e GATT sem
# resposta (Celer Remote conectava e expirava no MTU/descoberta)
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
