# Cheap Yellow Display (ESP32-2432S028R): ESP32 classico 4MB, sem PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4MB.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Slot OTA de 1.75MB: logs ESP_LOGD/V ficam fora do binario (o VERBOSE do
# sdkconfig.defaults comum foi para depurar o touch I2C da SmartDisplay e
# custava dezenas de KB de strings aqui).
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
# CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE is not set
# Logs ESP_LOGI (IDF + componentes) tambem ficam fora: o logcat do CelerOS
# (celer_log_*) nao passa por ESP_LOG e segue completo.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# CONFIG_LOG_DEFAULT_LEVEL_INFO is not set

# Bundle de CAs "comum" (~45 raizes que cobrem a grande maioria dos sites:
# GitHub, Let's Encrypt, DigiCert...) em vez do completo: ~35 KB a menos no
# slot de 1.75MB. A SmartDisplay (16MB) segue com o bundle completo.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL is not set

# O slot microSD desta variante compartilha o HSPI do TFT (CS=5): o mount
# dedicado conflitaria com o display. Sem SD até o mount suportar bus
# compartilhado — e o FAT/SDSPI saem do binário (bônus de tamanho).
# CONFIG_CELEROS_SD_CARD is not set

# Heap para apps JS (32KB padrao roubam 12KB da RAM interna que o runtime
# Duktape precisa). Pico medido: ~8,5KB compilando o App Store (o compile
# do Duktape e recursivo); 20KB deixa folga para apps mais aninhados.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480

# RAM interna (sem PSRAM): o WiFi reservava 10 buffers RX estaticos (~16KB
# fixos) e o AMPDU RX segura mais. 4 estaticos + 16 dinamicos sobram para o
# trafego da CYD (loja, OTA, web server) — throughput menor, heap maior.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set

# Stacks do sistema pelo uso medido (celerctl ps, App Store rodando com
# HTTPS): sys_evt usa ~2KB dos 8KB do comum; esp_timer ~0,4KB de 3,5KB.
# O que sobra vira heap 8-bit — o handshake TLS de um app com rede precisa.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2560

# Unicore: habilita a IRAM livre (~40KB, so acesso 32-bit) como memoria
# acessivel a byte (emulacao por excecao, ~167 ciclos por acesso). Recebem
# essa regiao, fora do heap 8-bit: o buffer do fonte durante o compile de
# app JS (CelerKernel) e os buffers do TLS (mbedTLS). Sem isso os apps com
# rede de ~30KB (Settings, App Store) nao cabiam na RAM interna. O segundo
# core pouco rendia aqui (UI single-thread; WiFi divide o core 0).
CONFIG_ESP_SYSTEM_SINGLE_CORE_MODE=y
CONFIG_FREERTOS_UNICORE=y
CONFIG_ESP32_IRAM_AS_8BIT_ACCESSIBLE_MEMORY=y
CONFIG_MBEDTLS_IRAM_8BIT_MEM_ALLOC=y
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
# Buffers TLS FIXOS (16KB RX + 4KB TX): o modo IRAM so desvia alocacoes
# >= 4KB — com CONFIG_MBEDTLS_DYNAMIC_BUFFER os buffers viravam pedacos
# menores e caiam todos no heap 8-bit (handshake OOM medido).
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is not set
