# CelerOS - segredos locais (NUNCA comitar este arquivo; o .gitignore ja cobre)
# Copie para .env e preencha. O helper tools/push_ai_key.py le este arquivo
# para provisionar a chave no device (/local/<provider>_key.txt).
#
# Chave da API da DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-sua-chave-aqui
#
# Chave da OpenRouter (https://openrouter.ai) — provider do app Qwen
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui
