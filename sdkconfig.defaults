# KryonOS — configuracao comum aos alvos (por-placa em boards/<board>/)
CONFIG_PARTITION_TABLE_CUSTOM=y

# Biblioteca esp_components usa try/catch (nlohmann/json, etc.)
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMUL_POOL_SIZE=64

# A task main roda a UI + heap Duktape
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# TLS sem validacao de certificado (mesmo padrao do updater anterior:
# WiFiClientSecure::setInsecure). Revisar antes de producao.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_CERT_VERIFY=y

CONFIG_FREERTOS_HZ=1000

# Diagnostico: habilita ESP_LOGV do LovyanGFX (tag LGFX) p/ debug do touch I2C
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
